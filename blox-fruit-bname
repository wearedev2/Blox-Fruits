-- ─── ANIMATION HELPERS ────────────────────────────
local seqId = 0
local activeTweens = {}

local function animateBar(bar, pct, targetPercent, duration, myId)
    if activeTweens[bar] then activeTweens[bar]:Cancel() end
    local startPercent = bar.Size.X.Scale * 100
    local startTime = tick()
    local tween = TweenService:Create(
        bar,
        TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = UDim2.new(targetPercent / 100, 0, 1, 0) }
    )
    activeTweens[bar] = tween

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if seqId ~= myId or not bar.Parent then conn:Disconnect() return end
        local elapsed = tick() - startTime
        local a = math.min(elapsed / duration, 1)
        local eased = 1 - (1 - a) * (1 - a)
        pct.Text = math.floor(startPercent + (targetPercent - startPercent) * eased) .. "%"
    end)

    tween:Play()
    tween.Completed:Wait()
    conn:Disconnect()
    if seqId == myId then pct.Text = math.floor(targetPercent) .. "%" end
end

local function resetBars()
    barLoad.Size = UDim2.new(0, 0, 1, 0)
    barConn.Size = UDim2.new(0, 0, 1, 0)
    barKey.Size  = UDim2.new(0, 0, 1, 0)
    pctLoad.Text = "0%"
    pctConn.Text = "0%"
    pctKey.Text  = "0%"
    keyNote.Visible = false
end

local function runSequence()
    if not main.Visible then return end
    seqId = seqId + 1
    local myId = seqId
    resetBars()

    task.wait(0.15)
    if seqId ~= myId then return end
    animateBar(barLoad, pctLoad, 100, 1.0, myId)
    if seqId ~= myId then return end

    task.wait(0.15)
    if seqId ~= myId then return end
    animateBar(barConn, pctConn, 100, 0.9, myId)
    if seqId ~= myId then return end

    task.wait(0.15)
    if seqId ~= myId then return end
    animateBar(barKey, pctKey, 58, 0.85, myId)
    if seqId ~= myId then return end
    keyNote.Visible = true
end

-- ─── OPEN / CLOSE ─────────────────────────────────
local lastPos = UDim2.new(0.5, 0, 0.5, 0)
local canDrag = false

local function openPanel()
    canDrag = false
    main.Visible = true
    launcher.Visible = false
    mainScale.Scale = 0.7
    main.Position = UDim2.new(lastPos.X.Scale, lastPos.X.Offset, lastPos.Y.Scale, lastPos.Y.Offset + 32)
    mainStroke.Transparency = 0.7

    TweenService:Create(mainScale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
    TweenService:Create(main, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = lastPos }):Play()
    TweenService:Create(mainStroke, TweenInfo.new(0.5), { Transparency = 0.3 }):Play()

    task.delay(0.55, function()
        if main.Visible then
            canDrag = true
            task.spawn(runSequence)
        end
    end)
end

local function closePanel()
    canDrag = false
    TweenService:Create(mainStroke, TweenInfo.new(0.2), { Transparency = 0.85 }):Play()
    TweenService:Create(mainScale, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.7 }):Play()
    local ct = TweenService:Create(
        main,
        TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Position = UDim2.new(lastPos.X.Scale, lastPos.X.Offset, lastPos.Y.Scale, lastPos.Y.Offset + 32) }
    )
    ct:Play()
    ct.Completed:Wait()
    main.Visible = false
    launcher.Visible = true
end

-- ─── DRAG ─────────────────────────────────────────
local dragging, dragStart, startPos

local function tryStartDrag(input)
    if not canDrag then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end

header.InputBegan:Connect(tryStartDrag)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        if dragging then
            dragging = false
            lastPos = main.Position
        end
    end
end)

-- ─── COPY LINK ────────────────────────────────────
local function tryCopy()
    for _, f in ipairs({ setclipboard, toclipboard, set_clipboard, toClipboard }) do
        if type(f) == "function" and pcall(f, LINK) then return true end
    end
    return false
end

local function copyLink()
    if tryCopy() then
        manualBox.Visible = false
        local orig = getKeyBtn.Text
        getKeyBtn.Text = "COPIED!"
        TweenService:Create(getKeyBtn, TweenInfo.new(0.12), { BackgroundColor3 = ACCENT }):Play()
        task.wait(1.4)
        getKeyBtn.Text = orig
        TweenService:Create(getKeyBtn, TweenInfo.new(0.12), { BackgroundColor3 = ACCENT2 }):Play()
    else
        manualBox.Visible = true
    end
end

