-- ===================== HELPERS =====================
local function setBar(bar, pct, percent)
    bar.Size = UDim2.new(percent / 100, 0, 1, 0)
    pct.Text = math.floor(percent) .. "%"
end

-- Smooth animated bar (uses Heartbeat for the percentage, TweenService for width)
local function animateBar(bar, pct, targetPercent, duration)
    local startPercent = bar.Size.X.Scale * 100
    local startTime = tick()
    local finished = false

    local tween = TweenService:Create(
        bar,
        TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = UDim2.new(targetPercent / 100, 0, 1, 0) }
    )

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if finished then return end
        local elapsed = tick() - startTime
        local a = math.min(elapsed / duration, 1)
        local eased = 1 - (1 - a) * (1 - a)  -- ease-out-quad
        pct.Text = math.floor(startPercent + (targetPercent - startPercent) * eased) .. "%"
    end)

    tween:Play()
    tween.Completed:Wait()
    finished = true
    conn:Disconnect()
    pct.Text = math.floor(targetPercent) .. "%"
end

-- ===================== LOADING SEQUENCE =====================
local function runSequence()
    setBar(barLoad, pctLoad, 0)
    setBar(barConn, pctConn, 0)
    setBar(barKey,  pctKey,  0)
    keyNote.Visible = false

    task.wait(0.15)
    animateBar(barLoad, pctLoad, 100, 1.0)
    task.wait(0.2)

    animateBar(barConn, pctConn, 100, 0.9)
    task.wait(0.2)

    animateBar(barKey,  pctKey,   58, 0.85)
    keyNote.Visible = true
end

-- ===================== OPEN / CLOSE =====================
local function openPanel()
    if main.Visible then return end
    main.Visible = true
    launcher.Visible = false
    mainScale.Scale = 0.85

    TweenService:Create(
        mainScale,
        TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Scale = 1 }
    ):Play()

    task.delay(0.05, function()
        task.spawn(runSequence)
    end)
end

local function closePanel()
    if not main.Visible then return end
    TweenService:Create(
        mainScale,
        TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Scale = 0.82 }
    ):Play()
    task.wait(0.18)
    main.Visible = false
    launcher.Visible = true
    mainScale.Scale = 1
end

-- ===================== COPY LINK =====================
local function tryCopy()
    local funcs = { setclipboard, toclipboard, set_clipboard, toClipboard }
    for _, f in ipairs(funcs) do
        if type(f) == "function" then
            local ok = pcall(f, LINK)
            if ok then return true end
        end
    end
    return false
end

local function copyLink()
    if tryCopy() then
        manualBox.Visible = false
        local original = getKeyBtn.Text
        getKeyBtn.Text = "COPIED!"
        TweenService:Create(getKeyBtn, TweenInfo.new(0.12), { BackgroundColor3 = ACCENT }):Play()
        task.wait(1.4)
        getKeyBtn.Text = original
        TweenService:Create(getKeyBtn, TweenInfo.new(0.12), { BackgroundColor3 = ACCENT2 }):Play()
    else
        manualBox.Visible = true
        getKeyBtn.Text = "COPY MANUALLY"
        task.wait(1.4)
        getKeyBtn.Text = "GET KEY"
    end
end

